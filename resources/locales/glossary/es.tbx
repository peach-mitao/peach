<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="zh_Hans">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Weblate Glossary</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry id="ref.13" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>用户脚本</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.05" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>设备</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.19" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>缩略图</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.subscriptions" weblate-flags="terminology">
                <descrip>管理关注的创作者、女优与 JAV 订阅。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>关注管理</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.04" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>登录</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.unseen" weblate-flags="terminology">
                <descrip>还没播放过的作品。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>没看过</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.newRelease" weblate-flags="terminology">
                <descrip>关注对象新发行的作品。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>新作</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.agency" weblate-flags="terminology">
                <descrip>艺人所属的经纪公司。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>事务所</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.flagged" weblate-flags="terminology">
                <descrip>人工标记过的作品。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>已标记</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.42" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>规则</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.08" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>托盘</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.want" weblate-flags="terminology">
                <descrip>标记想获取的外部作品，之后可以找资源下载。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>想要</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.moveToTrash" weblate-flags="terminology">
                <descrip>可还原的删除。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>移入回收站</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="state.unknown" weblate-flags="terminology">
                <descrip>值不知道。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>未知</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.cancelTask" weblate-flags="terminology">
                <descrip>让排队或运行中的任务不再继续。界面上写作“取消任务”“取消后续任务”；单独一个“取消”是对话框的退出键，归上一条。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>取消</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.manage" weblate-flags="terminology">
                <descrip>顶栏的管理菜单，收着任务中心、数据管理、关注管理、统计、口味和 Peach 配置。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>管理</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.credit.0" weblate-flags="terminology">
                <descrip>作品挂在哪个艺人、创作者、厂牌、系列名下。「未归属」是没有署名人的作品，有自己的入口。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>归属</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.31" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>字幕</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.26" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>身份</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="state.ok" weblate-flags="terminology">
                <descrip>检查通过、状态没问题。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>正常</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.save" weblate-flags="terminology">
                <descrip>写入当前编辑。设置页主按钮统一叫“保存配置”。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>保存</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.expand" weblate-flags="terminology">
                <descrip>展开一块内容；与“收起”成对，收起译作 Collapse。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>展开</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.playlist" weblate-flags="terminology">
                <descrip>用户整理的播放集合；“播放队列”是本次播放顺序。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>播放列表</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.following" weblate-flags="terminology">
                <descrip>侧栏入口“关注”、关注页的大标题和导航排序里的“关注”：指关注更新流这个页面，不是动作。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>关注</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.feeds" weblate-flags="terminology">
                <descrip>设置分区：关注采集与订阅拉取的参数。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>来源与订阅</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.24" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>人物</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.folder" weblate-flags="terminology">
                <descrip>磁盘或网盘上的文件夹：媒体目录、数据目录、目标目录、缓存目录都是它。全量文案里出现约 400 次。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>目录</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.45" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>标题</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.25" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>档案</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.stats" weblate-flags="terminology">
                <descrip>馆藏与观看统计。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>统计</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.resume" weblate-flags="terminology">
                <descrip>从暂停处继续。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>继续</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.thisComputer.1" weblate-flags="terminology">
                <descrip>运行 Peach 服务的那台电脑。和它相对的是连上来的浏览器、手机，统称「设备」。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>这台电脑</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.cancel" weblate-flags="terminology">
                <descrip>放弃当前编辑或关闭对话框，不影响后台任务。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>取消</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.38" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>识别</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.pause" weblate-flags="terminology">
                <descrip>暂时停下，之后可以继续。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>暂停</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.video.1" weblate-flags="terminology">
                <descrip>用户看到的一部片子。作品偏身份（番号层），影片和视频偏可播放的那一份。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>影片</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.29" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>评分</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.watchLater" weblate-flags="terminology">
                <descrip>用户排进“稍后看”的作品。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>稍后看</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.undo" weblate-flags="terminology">
                <descrip>撤销刚才的一步操作，通常在通知里。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>撤销</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="state.queued" weblate-flags="terminology">
                <descrip>已提交，还没开始。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>排队中</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.02" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>凭据</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.20" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>抽帧</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.18" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>修复</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.tag" weblate-flags="terminology">
                <descrip>作品的分类标签。界面里的“标签”二字要翻译，标签值本身属于内容。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>标签</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.cloudDownload" weblate-flags="terminology">
                <descrip>提交到 115、PikPak 等网盘的离线下载。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>云下载</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.thisComputer.0" weblate-flags="terminology">
                <descrip>运行 Peach 服务的那台电脑。和它相对的是连上来的浏览器、手机，统称「设备」。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>本机</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.discover.1" weblate-flags="terminology">
                <descrip>按口味推荐作品。“馆藏探索”在已有作品里推荐，“库外发现”推荐还没有的。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>探索</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.scrape" weblate-flags="terminology">
                <descrip>从资料站抓作品资料（标题、演员、厂牌等）。界面上主要见于「刮削记录」导出和排查说明。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>刮削</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="state.running.0" weblate-flags="terminology">
                <descrip>正在执行。两个中文写法英文合并。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>运行中</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.library" weblate-flags="terminology">
                <descrip>用户配置的一组媒体目录，有自己的名字，侧栏可以切换，一个实例可以有多个。目录各自存放在哪种位置（本地磁盘、115、PikPak）是下面的“媒体来源”。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>媒体库</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.retry" weblate-flags="terminology">
                <descrip>再执行一次失败的步骤。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>重试</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.creator" weblate-flags="terminology">
                <descrip>自己发布作品的个人或账号，如社媒博主、动画作者。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>创作者</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.candidate" weblate-flags="terminology">
                <descrip>带来源和置信度、还没确认的资料。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>候选</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.scan" weblate-flags="terminology">
                <descrip>检查媒体库目录，找出新增、改名和删除的文件。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>扫描</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.file" weblate-flags="terminology">
                <descrip>磁盘或网盘上的一个具体文件。一部作品可以对应多个文件。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>文件</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.findDownloads" weblate-flags="terminology">
                <descrip>用配置的索引器搜这部作品的下载资源（磁力、网盘）。找到后由你选择下载。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>查找资源</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.06" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>局域网</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.performer" weblate-flags="terminology">
                <descrip>所有类型出演者的总称，含非 JAV 的演员。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>艺人</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.enrich" weblate-flags="terminology">
                <descrip>只给缺资料的作品补齐，不覆盖已有内容。与“重新采集”不同。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>补全资料</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="state.canceled" weblate-flags="terminology">
                <descrip>被取消，没有完成。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>已取消</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.fullVideo" weblate-flags="terminology">
                <descrip>关注条目或下载里真正的完整视频，相对于预告、预览图。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>正片</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.reset" weblate-flags="terminology">
                <descrip>把设置或顺序改回出厂值。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>恢复默认</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.duplicates" weblate-flags="terminology">
                <descrip>同一作品的多个文件。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>重复文件</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.accessToken" weblate-flags="terminology">
                <descrip>没设访问密码时系统生成的登录口令，也是脚本和 API 放在 X-Token 请求头里的那串值。和用户自己设的「访问密码」是两样东西。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>访问口令</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.27" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>发行</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.stop" weblate-flags="terminology">
                <descrip>让持续运行的服务或循环停下，如公网入口。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>停止</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="nav.preferences" weblate-flags="terminology">
                <descrip>每个浏览器各自的显示与播放偏好。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>设置</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.32" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>无码</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.import" weblate-flags="terminology">
                <descrip>把一个文件登记进馆藏。下载完成不等于入库。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>入库</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.03" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>账号</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="ref.11" weblate-flags="terminology">
                <langSet xml:lang="zh_Hans"><tig><term>索引器</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="act.selectAll" weblate-flags="terminology">
                <descrip>选中当前页全部条目。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>全选</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.storage" weblate-flags="terminology">
                <descrip>一个目录存放在哪种位置：本地磁盘、115、PikPak。媒体库设置里每个目录旁边那个“来源”下拉选的就是它；资源同步结果按它分卡。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>媒体来源</term></tig></langSet>
