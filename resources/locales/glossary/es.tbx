            <termEntry id="concept.region" weblate-flags="terminology">
                <descrip>作品的制作地区（日本、欧美、国产等），可批量判定，判定后刮削不再改写。</descrip>
                <langSet xml:lang="zh_Hans"><tig><term>产地</term></tig></langSet>
                <langSet xml:lang="es"><tig><term></term></tig></langSet>
            </termEntry>
            <termEntry id="concept.rollback.0" weblate-flags="terminology">
